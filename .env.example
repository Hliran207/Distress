# Telegram
TELEGRAM_BOT_TOKEN=

# MongoDB Atlas
MONGO_URI=
MONGO_DB=reddit_distress_db
MONGO_COLLECTION=telegram_posts

# HuggingFace
HF_REPO_ID=Hliran2/distilbert-distress-detector
HF_REVISION=

# Kafka
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=telegram.messages
KAFKA_DLQ_TOPIC=telegram.messages.dlq

# Cascade
FAST_THRESHOLD=0.5
BERT_THRESHOLD=0.5
UNCERTAINTY_LOW=0.25
UNCERTAINTY_HIGH=0.75
AUDIT_RATE=0